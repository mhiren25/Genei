import os
import json
import re
import faiss
import numpy as np
from math import exp
from pydantic import BaseModel
from langgraph.graph import StateGraph, END
from langchain_openai import AzureChatOpenAI
from langchain.embeddings import AzureOpenAIEmbeddings

# Make sure to set these environment variables:
# AZURE_OPENAI_API_KEY, AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_DEPLOYMENT, AZURE_OPENAI_API_VERSION


os.environ["AZURE_OPENAI_API_KEY"] = "<YOUR_KEY>"
os.environ["AZURE_OPENAI_ENDPOINT"] = "https://<YOUR_RESOURCE>.openai.azure.com/"
os.environ["AZURE_OPENAI_API_VERSION"] = "2024-02-15-preview"

llm = AzureChatOpenAI(
    deployment=os.environ["AZURE_OPENAI_DEPLOYMENT"],
    temperature=0,
    azure_api_key=os.environ["AZURE_OPENAI_API_KEY"],
    azure_endpoint=os.environ["AZURE_OPENAI_ENDPOINT"],
    azure_api_version=os.environ["AZURE_OPENAI_API_VERSION"]
)

embeddings = AzureOpenAIEmbeddings(
    deployment=os.environ["AZURE_OPENAI_DEPLOYMENT"],
    model="text-embedding-3-large",
    chunk_size=1,
    azure_api_key=os.environ["AZURE_OPENAI_API_KEY"],
    azure_endpoint=os.environ["AZURE_OPENAI_ENDPOINT"],
    azure_api_version=os.environ["AZURE_OPENAI_API_VERSION"]
)


USER_HISTORY = [
    {"symbol": "AAPL", "strategy": "VWAP", "quantity": 100, "volatility": "LOW", "days_ago": 3},
    {"symbol": "AAPL", "strategy": "VWAP", "quantity": 150, "volatility": "MEDIUM", "days_ago": 7},
    {"symbol": "MSFT", "strategy": "TWAP", "quantity": 200, "volatility": "LOW", "days_ago": 15},
    {"symbol": "AAPL", "strategy": "MARKET", "quantity": 50, "volatility": "HIGH", "days_ago": 30},
]


def trade_to_text(t):
    return f"{t['symbol']} {t['strategy']} qty {t['quantity']} vol {t['volatility']}"


# Embed all historical trades
texts = [trade_to_text(h) for h in USER_HISTORY]
vectors = embeddings.embed_documents(texts)
vectors = np.array(vectors).astype("float32")

faiss_index = faiss.IndexFlatL2(vectors.shape[1])
faiss_index.add(vectors)




def retrieve_similar_trades(intent, k=2):
    query_text = f"{intent['symbol']} qty {intent['quantity']}"
    query_vec = np.array(embeddings.embed_query(query_text)).astype("float32").reshape(1, -1)
    _, idxs = faiss_index.search(query_vec, k)
    return [USER_HISTORY[i] for i in idxs[0]]

from collections import Counter

def build_behavior_profile(history, decay_days=30):
    strategy_score = Counter()
    total_weight = 0
    qty_sum = 0

    for h in history:
        weight = exp(-h["days_ago"] / decay_days)
        strategy_score[h["strategy"]] += weight
        qty_sum += h["quantity"] * weight
        total_weight += weight

    return {
        "preferred_strategies": {k: round(v / total_weight, 2) for k, v in strategy_score.items()},
        "avg_order_size": round(qty_sum / total_weight),
        "volatility_tolerance": "MEDIUM",
        "override_rate": 0.15
    }


from typing import Dict, Any, List

class TradeState(BaseModel):
    input_text: str
    intent: Dict[str, Any] = {}
    market: Dict[str, Any] = {}
    emotion: str = ""
    behavior_profile: Dict[str, Any] = {}
    similar_trades: List[Dict[str, Any]] = []
    strategy: Dict[str, Any] = {}

def parse_intent(state: TradeState):
    text = state.input_text.upper()
    side = "BUY" if "BUY" in text else "SELL" if "SELL" in text else "BUY"
    qty_match = re.search(r"(\d+)", text)
    quantity = int(qty_match.group(1)) if qty_match else 100
    symbol_match = re.search(r"(?:OF\s+)?([A-Z]+)", text)
    symbol = symbol_match.group(1) if symbol_match else "UNKNOWN"
    state.intent = {"symbol": symbol, "quantity": quantity, "side": side, "type": "MARKET"}
    return state

def market_and_emotion(state: TradeState):
    state.market = {"volatility": "LOW", "liquidity": "HIGH"}
    state.emotion = "CALM"
    return state

def enrich_with_history(state: TradeState):
    # Symbol-specific history
    symbol_history = [h for h in USER_HISTORY if h["symbol"] == state.intent["symbol"]]
    if not symbol_history:  # fallback to full history
        symbol_history = USER_HISTORY
    state.behavior_profile = build_behavior_profile(symbol_history)
    state.similar_trades = retrieve_similar_trades(state.intent)
    return state

ALLOWED_STRATEGIES = ["MARKET", "VWAP", "TWAP", "POC", "ICEBERG"]

def llm_strategy_decision(state: TradeState):
    prompt = f"""
Choose ONE trading execution strategy from {ALLOWED_STRATEGIES}.
Rules: choose only one, respond in valid JSON only.

Order:
{state.intent}

Market:
{state.market}

Emotion:
{state.emotion}

Behavior Profile:
{state.behavior_profile}

Similar Trades:
{state.similar_trades}

Return JSON:
{{ "strategy": "<NAME>" }}
"""
    response = llm.invoke(prompt)
    try:
        result = json.loads(response.content)
        strategy = result["strategy"]
        if strategy not in ALLOWED_STRATEGIES:
            strategy = "VWAP"
    except Exception:
        strategy = "VWAP"
    state.strategy = {"strategy": strategy}
    return state

graph = StateGraph(TradeState)
graph.add_node("intent", parse_intent)
graph.add_node("market", market_and_emotion)
graph.add_node("history", enrich_with_history)
graph.add_node("decision", llm_strategy_decision)

graph.set_entry_point("intent")
graph.add_edge("intent", "market")
graph.add_edge("market", "history")
graph.add_edge("history", "decision")
graph.add_edge("decision", END)

app = graph.compile()

state = TradeState(input_text="Buy 300 shares of TSLA now")
result = app.invoke(state)

print("Intent:", result.intent)
print("Behavior Profile:", result.behavior_profile)
print("Similar Trades:", result.similar_trades)
print("Strategy Decision:", result.strategy)
