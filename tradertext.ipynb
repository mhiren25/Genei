def parse_intent(state: TradeState):
    """Use LLM to extract trading intent from natural language"""
    text = state.input_text
    
    prompt = f"""Extract trading order details from this request. Analyze the text carefully and return ONLY a valid JSON object.

User Input: "{text}"

Return ONLY this JSON structure with NO additional text before or after:
{{
  "symbol": "STOCK_TICKER_SYMBOL",
  "quantity": number,
  "side": "BUY" or "SELL",
  "tif": "DAY" or "GTC" or "GTD",
  "requested_strategy": "VWAP" or "TWAP" or "POC" or "MOC" or null
}}

Extraction Rules:
1. symbol: The stock ticker symbol (e.g., TSLA, AAPL, META, NVDA). Look for 2-5 uppercase letters that represent a company. If not found, return "UNKNOWN"
2. quantity: The number of shares to trade. Look for numbers followed by "shares", "units", or just numbers in context. Default to 100 if not specified.
3. side: Determine if this is a "BUY" or "SELL" order. Default to "BUY" if unclear.
4. tif: Time in Force
   - "DAY" if "today", "day order", or no time specification (DEFAULT)
   - "GTC" if "good till cancel", "GTC", "until filled"
   - "GTD" if "good till date", "GTD", specific date mentioned
5. requested_strategy: ONLY if user explicitly mentions one of these strategies: VWAP, TWAP, POC, MOC. Otherwise return null.

Examples:
Input: "Buy 200 shares of TSLA"
Output: {{"symbol": "TSLA", "quantity": 200, "side": "BUY", "tif": "DAY", "requested_strategy": null}}

Input: "Sell 150 AAPL using VWAP"
Output: {{"symbol": "AAPL", "quantity": 150, "side": "SELL", "tif": "DAY", "requested_strategy": "VWAP"}}

Input: "3000 META GTC"
Output: {{"symbol": "META", "quantity": 3000, "side": "BUY", "tif": "GTC", "requested_strategy": null}}

Input: "Buy 500 shares of NVDA immediately using TWAP, good till cancel"
Output: {{"symbol": "NVDA", "quantity": 500, "side": "BUY", "tif": "GTC", "requested_strategy": "TWAP"}}

IMPORTANT: Return ONLY the JSON object, no other text, no markdown formatting, no backticks.
"""
    
    try:
        response = llm.invoke(prompt)
        content = response.content.strip()
        
        # Remove markdown code blocks if present
        if content.startswith("```"):
            content = re.sub(r'^```(?:json)?\s*|\s*```

def llm_detect_emotion(state: TradeState):
    """FIXED: Better prompt for emotion detection"""
    prompt = f"""Analyze the urgency and emotion in this trading request.

User Input: "{state.input_text}"

Consider words like:
- "immediately", "urgent", "now", "asap" → URGENT
- "anxious", "worried", "concerned" → ANXIOUS
- "patient", "when ready", "no rush" → PATIENT
- Otherwise → CALM

Return ONLY valid JSON:
{{"emotion": "CALM"}}

Choose from: CALM, PATIENT, URGENT, ANXIOUS
"""
    response = llm.invoke(prompt)
    try:
        state.emotion = json.loads(response.content)["emotion"]
    except:
        state.emotion = "CALM"
    return state

def retrieve_similar_trades(state: TradeState, k=3):
    symbol = state.intent["symbol"]
    symbol_history = [h for h in USER_HISTORY if h["symbol"] == symbol]
    if not symbol_history:
        state.similar_trades = []
        return state

    texts = [
        f"{t['symbol']} {t['strategy']} SIDE:{t['side']} TIF:{t['tif']} QTY:{t['quantity']} VOL:{t['volatility']}"
        for t in symbol_history
    ]

    try:
        vectors = np.array(embeddings.embed_documents(texts)).astype("float32")
        index = faiss.IndexFlatL2(vectors.shape[1])
        index.add(vectors)

        query_text = f"{symbol} SIDE:{state.side} TIF:{state.tif} QTY:{state.intent['quantity']}"
        query_vec = np.array(embeddings.embed_query(query_text)).astype("float32").reshape(1, -1)

        _, idxs = index.search(query_vec, min(k, len(symbol_history)))
        state.similar_trades = [symbol_history[int(i)] for i in idxs[0] if i >= 0]
    except Exception as e:
        print(f"Similarity search failed: {e}")
        state.similar_trades = random.sample(symbol_history, min(k, len(symbol_history)))

    return state

def llm_build_behavior_profile(state: TradeState):
    symbol = state.intent["symbol"]
    symbol_history = [h for h in USER_HISTORY if h["symbol"] == symbol]
    trades_json = json.dumps(symbol_history or USER_HISTORY[:10], indent=2)

    prompt = f"""Analyze this trader's historical behavior and preferences.

Historical trades:
{trades_json}

Return ONLY valid JSON with this exact structure:
{{
  "preferred_strategies": ["STRATEGY1", "STRATEGY2"],
  "avg_order_size": 250,
  "volatility_tolerance": "MEDIUM",
  "side_preference": "BUY",
  "time_sensitivity": "MIXED",
  "behavioral_notes": "Brief summary of trading style"
}}

Use these values:
- volatility_tolerance: LOW, MEDIUM, or HIGH
- side_preference: BUY, SELL, or BALANCED
- time_sensitivity: PATIENT, URGENT, or MIXED
"""
    response = llm.invoke(prompt)
    try:
        state.behavior_profile = json.loads(response.content)
    except:
        state.behavior_profile = {
            "preferred_strategies": ["VWAP"],
            "avg_order_size": 200,
            "volatility_tolerance": "MEDIUM",
            "side_preference": "BALANCED",
            "time_sensitivity": "MIXED",
            "behavioral_notes": "Fallback profile"
        }
    return state

def parse_json_from_llm(text: str):
    match = re.search(r'\{[\s\S]*\}', text)
    if match:
        try:
            return json.loads(match.group())
        except:
            pass
    return {}

def llm_strategy_decision(state: TradeState):
    """FIXED: Respects user-requested strategy and generates parameters"""
    
    user_strategy = state.user_requested_strategy
    order_qty = state.intent.get('quantity', 0)
    adv = state.market_snapshot.get('adv', 0)
    order_pct_of_adv = state.market_snapshot.get('order_pct_of_adv', 0)
    tif = state.intent.get('tif', 'DAY')
    
    # Check if order size is problematic (>10% of ADV for DAY orders, >30% for multi-day)
    is_large_order = (tif == 'DAY' and order_pct_of_adv > 10) or (tif in ['GTC', 'GTD'] and order_pct_of_adv > 30)
    
    if user_strategy:
        # User requested a specific strategy - validate or explain why not to use it
        prompt = f"""The user has requested the {user_strategy} strategy for this order.

Order Details: {json.dumps(state.intent, indent=2)}
Emotion: {state.emotion}
Behavior Profile: {json.dumps(state.behavior_profile, indent=2)}
Market Snapshot: {json.dumps(state.market_snapshot, indent=2)}

IMPORTANT CONSIDERATIONS:
- Order quantity: {order_qty} shares
- Average Daily Volume (ADV): {adv:,} shares
- Order as % of ADV: {order_pct_of_adv}%
- Time in Force: {tif}

MARKET IMPACT RULES:
- For DAY orders: >10% of ADV requires careful execution (VWAP/TWAP recommended)
- For GTC/GTD orders: >30% of ADV requires multi-day strategy
- Large orders should avoid MOC to prevent closing imbalance

Should we use {user_strategy}? If yes, confirm it. If no, recommend a better strategy from: {', '.join(ALLOWED_STRATEGIES)}

Return ONLY valid JSON:
{{
  "strategy": "STRATEGY_NAME",
  "explanation": "Clear explanation of why this strategy is chosen or why user's choice was overridden. If order is too large for ADV, mention specific concerns about market impact.",
  "parameters": {{
    // Strategy-specific parameters based on the chosen strategy
  }},
  "warnings": ["List any warnings about market impact, liquidity concerns, or execution risks"]
}}

Strategy parameter guidelines:
- VWAP: {{"start_time": "09:30", "end_time": "16:00", "participation_rate": 0.1}}
- TWAP: {{"start_time": "09:30", "end_time": "16:00", "num_slices": 10}}
- POC (Percent of Close): {{"target_pct": 0.05, "start_time": "15:30"}}
- MOC (Market on Close): {{"submit_time": "15:45", "price_limit_pct": 0.01}}
"""
    else:
        # No user preference - recommend best strategy
        prompt = f"""Recommend the best trading strategy for this order.

Order Details: {json.dumps(state.intent, indent=2)}
Emotion: {state.emotion}
Behavior Profile: {json.dumps(state.behavior_profile, indent=2)}
Similar Past Trades: {json.dumps(state.similar_trades, indent=2)}
Market Snapshot: {json.dumps(state.market_snapshot, indent=2)}

IMPORTANT CONSIDERATIONS:
- Order quantity: {order_qty} shares
- Average Daily Volume (ADV): {adv:,} shares
- Order as % of ADV: {order_pct_of_adv}%
- Time in Force: {tif}

MARKET IMPACT RULES:
- For DAY orders: >10% of ADV requires careful execution (VWAP/TWAP recommended)
- For GTC/GTD orders: >30% of ADV requires multi-day strategy
- Large orders (>10% ADV) should avoid MOC to prevent closing price impact
- High volatility + large size → VWAP with lower participation rate
- Small orders (<5% ADV) → More flexibility in strategy choice

Choose ONE strategy from: {', '.join(ALLOWED_STRATEGIES)}

Return ONLY valid JSON:
{{
  "strategy": "STRATEGY_NAME",
  "explanation": "Clear reason why this strategy fits the order, market conditions, and user behavior. If order is large relative to ADV, explain market impact mitigation approach.",
  "parameters": {{
    // Strategy-specific parameters
  }},
  "warnings": ["List any warnings about market impact, liquidity concerns, or execution risks"]
}}

Strategy parameter guidelines:
- VWAP: {{"start_time": "09:30", "end_time": "16:00", "participation_rate": 0.1}}
- TWAP: {{"start_time": "09:30", "end_time": "16:00", "num_slices": 10}}
- POC: {{"target_pct": 0.05, "start_time": "15:30"}}
- MOC: {{"submit_time": "15:45", "price_limit_pct": 0.01}}

Consider:
- High volatility + large order → VWAP with conservative participation
- Urgent emotion but large order → TWAP to balance urgency with impact
- Patient trader + large order → VWAP or multi-day execution
- Order >10% ADV on DAY order → STRONG WARNING about market impact
"""
    
    response = llm.invoke(prompt)
    result = parse_json_from_llm(response.content)
    
    strategy_name = result.get("strategy", "VWAP")
    if strategy_name not in ALLOWED_STRATEGIES:
        strategy_name = "VWAP"
    
    # Ensure parameters exist
    parameters = result.get("parameters", {})
    if not parameters:
        # Provide default parameters based on strategy
        default_params = {
            "VWAP": {"start_time": "09:30", "end_time": "16:00", "participation_rate": 0.1},
            "TWAP": {"start_time": "09:30", "end_time": "16:00", "num_slices": 10},
            "POC": {"target_pct": 0.05, "start_time": "15:30"},
            "MOC": {"submit_time": "15:45", "price_limit_pct": 0.01}
        }
        parameters = default_params.get(strategy_name, {})
    
    # Add automatic warnings if needed
    warnings = result.get("warnings", [])
    if is_large_order and tif == 'DAY':
        warnings.append(f"⚠️ Order size is {order_pct_of_adv}% of ADV - significant market impact expected. Consider splitting across multiple days.")
    if order_pct_of_adv > 30 and tif == 'DAY':
        warnings.append(f"🚨 CRITICAL: Order is {order_pct_of_adv}% of ADV - this will likely cause severe market impact. Strongly recommend GTC or multi-day execution.")
    
    state.strategy = {
        "strategy": strategy_name,
        "explanation": result.get("explanation", f"Using {strategy_name} strategy"),
        "parameters": parameters,
        "warnings": warnings,
        "user_requested": user_strategy if user_strategy else None,
        "market_impact_analysis": {
            "order_size": order_qty,
            "adv": adv,
            "pct_of_adv": order_pct_of_adv,
            "risk_level": "HIGH" if order_pct_of_adv > 10 else "MODERATE" if order_pct_of_adv > 5 else "LOW"
        }
    }
    return state

# -------------------------------
# 8️⃣ Build Graph
# -------------------------------
graph = StateGraph(TradeState)
graph.add_node("intent", parse_intent)
graph.add_node("emotion", llm_detect_emotion)
graph.add_node("similar", retrieve_similar_trades)
graph.add_node("behavior", llm_build_behavior_profile)
graph.add_node("decision", llm_strategy_decision)

graph.set_entry_point("intent")
graph.add_edge("intent", "emotion")
graph.add_edge("emotion", "similar")
graph.add_edge("similar", "behavior")
graph.add_edge("behavior", "decision")
graph.add_edge("decision", END)

app = graph.compile()

