import os
import json
import re
import faiss
import numpy as np
import random
from pydantic import BaseModel
from langgraph.graph import StateGraph, END
from langchain_openai import AzureChatOpenAI
from langchain.embeddings import AzureOpenAIEmbeddings

# Make sure to set these environment variables:
# AZURE_OPENAI_API_KEY, AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_DEPLOYMENT, AZURE_OPENAI_API_VERSION

# -------------------------------
# 3️⃣ Dynamic User History Generator
# -------------------------------
def generate_user_history(symbols, num_trades_per_symbol=10):
    history = []
    for symbol, config in symbols.items():
        for _ in range(num_trades_per_symbol):
            trade = {
                "symbol": symbol,
                "strategy": random.choice(["VWAP","TWAP","MARKET","POC","ICEBERG"]),
                "quantity": random.randint(*config.get("quantity_range",(50,500))),
                "volatility": random.choice(config.get("volatility",["LOW","MEDIUM","HIGH"])),
                "days_ago": random.randint(1,60)
            }
            history.append(trade)
    return history

SYMBOL_CONFIG = {
    "AAPL": {"volatility":["LOW","MEDIUM"], "quantity_range":(50,200)},
    "TSLA": {"volatility":["MEDIUM","HIGH"], "quantity_range":(100,500)},
    "MSFT": {"volatility":["LOW","MEDIUM"], "quantity_range":(50,300)}
}

USER_HISTORY = generate_user_history(SYMBOL_CONFIG, num_trades_per_symbol=15)

# -------------------------------
# 4️⃣ Dynamic Market Snapshot Generator
# -------------------------------
def generate_market_snapshot(symbol, config=None):
    config = config or {}
    price_min, price_max = config.get("price_range",(100,500))
    adv_min, adv_max = config.get("adv_range",(500_000,5_000_000))
    vol_options = config.get("volatility",["LOW","MEDIUM","HIGH"])
    bias = config.get("bias",None)
    
    price = round(random.uniform(price_min,price_max),2)
    bid = round(price - random.uniform(0.05,0.50),2)
    ask = round(price + random.uniform(0.05,0.50),2)
    spread = round(ask - bid,2)
    adv = random.randint(adv_min,adv_max)
    adv30 = random.randint(adv_min,adv_max)
    volatility = random.choice(vol_options)
    depth = {"bids": random.randint(1000,5000), "asks": random.randint(1000,5000)}
    
    if bias=="positive":
        price *= 1 + random.uniform(0.01,0.05)
        adv *= 1 + random.uniform(0.01,0.1)
    elif bias=="negative":
        price *= 1 - random.uniform(0.01,0.05)
        adv *= 1 - random.uniform(0.01,0.1)
    
    return {
        "symbol": symbol,
        "price": round(price,2),
        "bid": round(bid,2),
        "ask": round(ask,2),
        "spread": round(spread,2),
        "ADV": adv,
        "ADV30": adv30,
        "volatility": volatility,
        "depth": depth
    }

# Example: market_snapshot_tsla = generate_market_snapshot("TSLA", {"price_range":(600,650),"adv_range":(1_000_000,5_000_000),"volatility":["MEDIUM","HIGH"],"bias":"positive"})

# -------------------------------
# 5️⃣ Azure LLM + Embeddings Initialization
# -------------------------------
llm = AzureChatOpenAI(
    deployment=os.environ["AZURE_OPENAI_DEPLOYMENT"],
    temperature=0,
    azure_api_key=os.environ["AZURE_OPENAI_API_KEY"],
    azure_endpoint=os.environ["AZURE_OPENAI_ENDPOINT"],
    azure_api_version=os.environ["AZURE_OPENAI_API_VERSION"]
)

embeddings = AzureOpenAIEmbeddings(
    deployment=os.environ["AZURE_OPENAI_DEPLOYMENT"],
    model="text-embedding-3-large",
    chunk_size=1,
    azure_api_key=os.environ["AZURE_OPENAI_API_KEY"],
    azure_endpoint=os.environ["AZURE_OPENAI_ENDPOINT"],
    azure_api_version=os.environ["AZURE_OPENAI_API_VERSION"]
)

# -------------------------------
# 6️⃣ Trade to Text Helper
# -------------------------------
def trade_to_text(t):
    return f"{t['symbol']} {t['strategy']} qty {t['quantity']} vol {t['volatility']}"

# -------------------------------
# 7️⃣ Symbol-Specific Similar Trades Retrieval
# -------------------------------
def retrieve_similar_trades(intent, k=3):
    symbol_history = [h for h in USER_HISTORY if h["symbol"]==intent["symbol"]]
    if not symbol_history:
        return []
    
    texts = [trade_to_text(h) for h in symbol_history]
    vectors = embeddings.embed_documents(texts)
    vectors = np.array(vectors).astype("float32")
    
    index = faiss.IndexFlatL2(vectors.shape[1])
    index.add(vectors)
    
    query_text = f"{intent['symbol']} qty {intent['quantity']}"
    query_vec = np.array(embeddings.embed_query(query_text)).astype("float32").reshape(1,-1)
    _, idxs = index.search(query_vec, min(k,len(symbol_history)))
    return [symbol_history[i] for i in idxs[0]]

# -------------------------------
# 8️⃣ Behavior Profile Builder
# -------------------------------
def llm_build_behavior_profile(state: TradeState):
    """
    Generates AI-driven user behavior profile from historical trades.
    """
    # Filter symbol-specific history
    symbol_history = [h for h in USER_HISTORY if h["symbol"] == state.intent["symbol"]]
    trades_json = json.dumps(symbol_history) if symbol_history else json.dumps(USER_HISTORY)

    prompt = f"""
You are an AI that summarizes a user's historical trading behavior.
Given the following trades, produce a JSON profile with:

- preferred_strategies: most used strategies
- avg_order_size: typical order quantity
- volatility_tolerance: LOW, MEDIUM, HIGH
- side_preference: BUY, SELL, or BALANCED
- time_sensitivity: PATIENT, URGENT, MIXED
- behavioral_notes: any patterns the user consistently shows

Historical Trades:
{trades_json}

Return JSON only.
"""
    response = llm.invoke(prompt)
    try:
        profile = json.loads(response.content)
    except Exception:
        profile = {}
    
    state.behavior_profile = profile
    return state


def enrich_with_history(state):
    symbol_history = [h for h in USER_HISTORY if h["symbol"]==state.intent["symbol"]]
    if symbol_history:
        state.behavior_profile = build_behavior_profile(symbol_history)
    else:
        state.behavior_profile = {}
    state.similar_trades = retrieve_similar_trades(state.intent)
    return state

# -------------------------------
# 9️⃣ LangGraph State Definition
# -------------------------------
class TradeState(BaseModel):
    input_text: str
    intent: dict = {}
    emotion: str = ""
    behavior_profile: dict = {}
    similar_trades: list = []
    strategy: dict = {}
    market_snapshot: dict = {}
    side: str = ""
    tif: str = ""

# -------------------------------
# 🔟 Parse Intent Node (Symbol, Quantity, Side, TIF)
# -------------------------------
def parse_intent(state: TradeState):
    text = state.input_text.upper()
    
    side = "BUY" if "BUY" in text else "SELL" if "SELL" in text else "BUY"
    qty_match = re.search(r"(\d+)", text)
    quantity = int(qty_match.group(1)) if qty_match else 100
    symbol_match = re.search(r"(?:OF\s+)?([A-Z]+)", text)
    symbol = symbol_match.group(1) if symbol_match else "UNKNOWN"
    
    # Simple TIF detection (DAY, GTC, GTD)
    tif = "DAY"
    if "GTC" in text: tif="GTC"
    if "GTD" in text: tif="GTD"
    
    state.intent = {"symbol":symbol,"quantity":quantity,"side":side,"type":"MARKET","tif":tif}
    state.side = side
    state.tif = tif
    # Generate market snapshot dynamically
    state.market_snapshot = generate_market_snapshot(symbol)
    
    return state

# -------------------------------
# 1️⃣1️⃣ AI-Driven Emotion Detection
# -------------------------------
def llm_detect_emotion(state: TradeState):
    prompt = f"""
You are an AI assistant that detects the user's emotional state from a trading instruction.
User Input: "{state.input_text}"
Identify the user's emotion as one of these: CALM, PATIENT, URGENT, ANXIOUS
Respond in JSON only: {{ "emotion": "<EMOTION_LABEL>" }}
"""
    response = llm.invoke(prompt)
    try:
        result = json.loads(response.content)
        emotion = result.get("emotion","CALM")
        if emotion not in ["CALM","PATIENT","URGENT","ANXIOUS"]:
            emotion="CALM"
    except Exception:
        emotion="CALM"
    state.emotion = emotion
    return state

# -------------------------------
# 1️⃣2️⃣ AI-Driven Strategy Decision with Explanation
# -------------------------------
ALLOWED_STRATEGIES = ["MARKET","VWAP","TWAP","POC","ICEBERG"]

def llm_strategy_decision(state: TradeState):
    """
    LLM chooses the strategy based on:
    - intent
    - emotion
    - AI-generated behavior profile
    - similar trades
    - dynamic market snapshot
    """
    prompt = f"""
You are a world-class financial trading strategist AI.
Recommend ONE execution strategy for the following trade.

Order: {state.intent}
User Emotion: {state.emotion}
Instrument Market Snapshot: {state.market_snapshot}
Behavior Profile: {state.behavior_profile}
Similar Trades: {state.similar_trades}

Provide JSON only with:
- strategy: "<STRATEGY_NAME>"
- explanation: "<WHY THIS STRATEGY IS APPROPRIATE>"
"""
    response = llm.invoke(prompt)
    try:
        result = json.loads(response.content)
        strategy = result.get("strategy")
        if strategy not in ALLOWED_STRATEGIES:
            strategy = "VWAP"
        explanation = result.get("explanation", "No explanation provided")
    except Exception:
        strategy = {"strategy": "VWAP", "explanation": "Fallback strategy used"}
    state.strategy = {"strategy": strategy, "explanation": explanation}
    return state


# -------------------------------
# 1️⃣3️⃣ Build LangGraph Pipeline
# -------------------------------
graph = StateGraph(TradeState)

graph.add_node("intent", parse_intent)
graph.add_node("emotion", llm_detect_emotion)
graph.add_node("history", enrich_with_history)
graph.add_node("behavior", llm_build_behavior_profile)  # NEW AI-driven behavior profile
graph.add_node("decision", llm_strategy_decision)

graph.set_entry_point("intent")
graph.add_edge("intent", "emotion")
graph.add_edge("emotion", "history")
graph.add_edge("history", "behavior")
graph.add_edge("behavior", "decision")
graph.add_edge("decision", END)

app = graph.compile()


# -------------------------------
# 1️⃣4️⃣ Test Run Example
# -------------------------------
state = TradeState(input_text="Buy 300 shares of TSLA immediately, GTC")
result = app.invoke(state)

print("Intent:", result.intent)
print("Emotion:", result.emotion)
print("Market Snapshot:", result.market_snapshot)
print("Similar Trades:", result.similar_trades)
print("Behavior Profile:", result.behavior_profile)
print("Strategy Decision:", result.strategy)
