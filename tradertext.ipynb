# Mock LLM and Embeddings for testing
import random

class MockLLM:
    def invoke(self, prompt):
        if "emotion" in prompt.lower():
            return type('Response', (), {'content': '{"emotion": "URGENT"}'})
        elif "summarizing" in prompt.lower():
            return type('Response', (), {'content': '{"preferred_strategies": ["VWAP", "TWAP"], "avg_order_size": 300, "volatility_tolerance": "HIGH", "side_preference": "BUY", "time_sensitivity": "URGENT", "behavioral_notes": "Prefers aggressive strategies in volatile markets"}'})
        else:
            return type('Response', (), {'content': '{"strategy": "ICEBERG", "explanation": "Suitable for large urgent order in volatile market to minimize impact"}'})

class MockEmbeddings:
    def embed_documents(self, texts):
        dim = 1536  # Dummy dimension (adjust if needed for real model)
        return [[random.random() for _ in range(dim)] for _ in texts]
    
    def embed_query(self, text):
        dim = 1536
        return [random.random() for _ in range(dim)]

use_mock = "AZURE_OPENAI_API_KEY" not in os.environ

llm = AzureChatOpenAI(
    deployment=os.environ.get("AZURE_OPENAI_CHAT_DEPLOYMENT", "gpt-4o"),
    temperature=0,
    azure_api_key=os.environ.get("AZURE_OPENAI_API_KEY"),
    azure_endpoint=os.environ.get("AZURE_OPENAI_ENDPOINT"),
    azure_api_version=os.environ.get("AZURE_OPENAI_API_VERSION", "2024-02-15-preview")
) if not use_mock else MockLLM()

embeddings = AzureOpenAIEmbeddings(
    deployment=os.environ.get("AZURE_OPENAI_EMBED_DEPLOYMENT", "text-embedding-3-large"),
    azure_api_key=os.environ.get("AZURE_OPENAI_API_KEY"),
    azure_endpoint=os.environ.get("AZURE_OPENAI_ENDPOINT"),
    azure_api_version=os.environ.get("AZURE_OPENAI_API_VERSION", "2024-02-15-preview"),
    model="text-embedding-3-large"
) if not use_mock else MockEmbeddings()

# -------------------------------
# 4️⃣ Hardcoded Market Data (for simplicity, as per request)
# -------------------------------
# Hardcoded synthetic but realistic snapshots for specific symbols.
# You can "play around" by editing these values directly.
# For the "current order", it's based on the symbol in input_text.
# Example: Recent TSLA data (as of hypothetical 2026 date): high volatility, etc.
MARKET_DATA = {
    "TSLA": [
        # 30-day history, latest at index -1
        *([{"date": f"Day-{i}", "open": 600 + i*2, "high": 610 + i*2, "low": 590 + i*2, "close": 605 + i*2, "volume": 5_000_000 + i*100_000} for i in range(1, 30)]),
        {"date": "Current", "open": 720.5, "high": 735.2, "low": 710.1, "close": 725.0, "volume": 8_500_000}  # Current snapshot
    ],
    "AAPL": [
        *([{"date": f"Day-{i}", "open": 250 + i, "high": 255 + i, "low": 245 + i, "close": 252 + i, "volume": 3_000_000 + i*50_000} for i in range(1, 30)]),
        {"date": "Current", "open": 280.3, "high": 285.0, "low": 275.5, "close": 282.1, "volume": 4_200_000}
    ],
    "META": [
        *([{"date": f"Day-{i}", "open": 600 + i*3, "high": 610 + i*3, "low": 590 + i*3, "close": 605 + i*3, "volume": 2_500_000 + i*80_000} for i in range(1, 30)]),
        {"date": "Current", "open": 650.0, "high": 660.4, "low": 640.2, "close": 655.3, "volume": 3_800_000}
    ]
}
# To simulate "API" but hardcoded: Add computed volatility to snapshot
def add_volatility_to_snapshot(snapshot, history):
    if history:
        closes = [d['close'] for d in history[-10:]]  # Last 10 days for std dev
        volatility = np.std(closes) / np.mean(closes) if closes else 0.02
        snapshot['volatility'] = round(volatility, 4)
    return snapshot

# -------------------------------
# 5️⃣ Synthetic User History
# -------------------------------
def generate_user_history(symbols, num_trades_per_symbol=15):
    history = []
    for symbol, config in symbols.items():
        for _ in range(num_trades_per_symbol):
            side = random.choice(["BUY", "SELL"])
            trade = {
                "symbol": symbol,
                "side": side,
                "strategy": random.choice(["VWAP", "TWAP", "MARKET", "POC", "ICEBERG"]),
                "quantity": random.randint(*config.get("quantity_range", (50, 500))),
                "volatility": random.choice(config.get("volatility", ["LOW", "MEDIUM", "HIGH"])),
                "tif": random.choice(["DAY", "GTC", "GTD"]),
                "days_ago": random.randint(1, 30)
            }
            history.append(trade)
    return history

SYMBOL_CONFIG = {
    "AAPL": {"volatility": ["LOW", "MEDIUM"], "quantity_range": (50, 200)},
    "TSLA": {"volatility": ["MEDIUM", "HIGH"], "quantity_range": (100, 500)},
    "META": {"volatility": ["LOW", "MEDIUM", "HIGH"], "quantity_range": (50, 300)}
}

USER_HISTORY = generate_user_history(SYMBOL_CONFIG)

# -------------------------------
# 6️⃣ State Definition
# -------------------------------
class TradeState(BaseModel):
    input_text: str
    intent: dict = {}
    emotion: str = ""
    behavior_profile: dict = {}
    similar_trades: list = []
    strategy: dict = {}
    market_snapshot: dict = {}
    side: str = ""
    tif: str = ""

ALLOWED_STRATEGIES = ["MARKET", "VWAP", "TWAP", "POC", "ICEBERG"]

# -------------------------------
# 7️⃣ Nodes
# -------------------------------
def parse_intent(state: TradeState):
    text = state.input_text.upper()
    side = "BUY" if "BUY" in text else "SELL" if "SELL" in text else "BUY"
    
    qty_match = re.search(r"(\d+)\s*(?:SHARES|OF|)", text)
    quantity = int(qty_match.group(1)) if qty_match else 100
    
    symbol_match = re.search(r"(?:OF\s+|FOR\s+|IN\s+|)([A-Z]{1,5})\b", text)
    symbol = symbol_match.group(1) if symbol_match else "UNKNOWN"

    tif = "DAY"
    if "GTC" in text: tif = "GTC"
    if "GTD" in text: tif = "GTD"

    state.intent = {"symbol": symbol, "quantity": quantity, "side": side, "type": "MARKET", "tif": tif}
    state.side = side
    state.tif = tif

    # Hardcoded market data for current order symbol
    if symbol in MARKET_DATA:
        history = MARKET_DATA[symbol][:-1]  # Exclude current for volatility calc
        snapshot = MARKET_DATA[symbol][-1].copy()
        snapshot = add_volatility_to_snapshot(snapshot, history)
        state.market_snapshot = snapshot
    else:
        state.market_snapshot = {"date": "Current", "open": 100.0, "high": 105.0, "low": 95.0, "close": 102.0, "volume": 1_000_000, "volatility": 0.02}

    return state

def llm_detect_emotion(state: TradeState):
    prompt = f"""
User Input: "{state.input_text}"
Return JSON only: {{ "emotion": "CALM" | "PATIENT" | "URGENT" | "ANXIOUS" }}
"""
    response = llm.invoke(prompt)
    try:
        state.emotion = json.loads(response.content)["emotion"]
    except:
        state.emotion = "CALM"
    return state

def retrieve_similar_trades(state: TradeState, k=3):
    symbol = state.intent["symbol"]
    symbol_history = [h for h in USER_HISTORY if h["symbol"] == symbol]
    if not symbol_history:
        state.similar_trades = []
        return state

    texts = [
        f"{t['symbol']} {t['strategy']} SIDE:{t['side']} TIF:{t['tif']} QTY:{t['quantity']} VOL:{t['volatility']}"
        for t in symbol_history
    ]

    try:
        vectors = np.array(embeddings.embed_documents(texts)).astype("float32")
        index = faiss.IndexFlatL2(vectors.shape[1])
        index.add(vectors)

        query_text = f"{symbol} SIDE:{state.side} TIF:{state.tif} QTY:{state.intent['quantity']}"
        query_vec = np.array(embeddings.embed_query(query_text)).astype("float32").reshape(1, -1)

        _, idxs = index.search(query_vec, min(k, len(symbol_history)))
        state.similar_trades = [symbol_history[int(i)] for i in idxs[0] if i >= 0]
    except Exception as e:
        print(f"Similarity search failed: {e}")
        state.similar_trades = random.sample(symbol_history, min(k, len(symbol_history)))  # Random fallback for testing

    return state

def llm_build_behavior_profile(state: TradeState):
    symbol = state.intent["symbol"]
    symbol_history = [h for h in USER_HISTORY if h["symbol"] == symbol]
    trades_json = json.dumps(symbol_history or USER_HISTORY[:10])

    prompt = f"""
Summarize trading behavior from these trades:
{trades_json}

Return JSON only:
{{
  "preferred_strategies": ["STRAT1", "STRAT2"],
  "avg_order_size": number,
  "volatility_tolerance": "LOW"|"MEDIUM"|"HIGH",
  "side_preference": "BUY"|"SELL"|"BALANCED",
  "time_sensitivity": "PATIENT"|"URGENT"|"MIXED",
  "behavioral_notes": "short description"
}}
"""
    response = llm.invoke(prompt)
    try:
        state.behavior_profile = json.loads(response.content)
    except:
        state.behavior_profile = {
            "preferred_strategies": ["VWAP"],
            "avg_order_size": 200,
            "volatility_tolerance": "MEDIUM",
            "side_preference": "BALANCED",
            "time_sensitivity": "MIXED",
            "behavioral_notes": "Fallback profile"
        }
    return state

def parse_json_from_llm(text: str):
    match = re.search(r'\{[\s\S]*\}', text)
    if match:
        try:
            return json.loads(match.group())
        except:
            pass
    return {}

def llm_strategy_decision(state: TradeState):
    prompt = f"""
You are a trading strategist. Recommend ONE strategy from: {', '.join(ALLOWED_STRATEGIES)}

Order: {json.dumps(state.intent)}
Emotion: {state.emotion}
Behavior: {json.dumps(state.behavior_profile)}
Similar trades: {json.dumps(state.similar_trades)}
Market: {json.dumps(state.market_snapshot)}

Return JSON only:
{{
  "strategy": "ONE_OF_{'_'.join(ALLOWED_STRATEGIES)}",
  "explanation": "clear reason why this strategy fits"
}}
"""
    response = llm.invoke(prompt)
    result = parse_json_from_llm(response.content)
    strategy_name = result.get("strategy", "VWAP")
    if strategy_name not in ALLOWED_STRATEGIES:
        strategy_name = "VWAP"
    state.strategy = {
        "strategy": strategy_name,
        "explanation": result.get("explanation", "Fallback: VWAP chosen")
    }
    return state

# -------------------------------
# 8️⃣ Build Graph
# -------------------------------
graph = StateGraph(TradeState)
graph.add_node("intent", parse_intent)
graph.add_node("emotion", llm_detect_emotion)
graph.add_node("similar", retrieve_similar_trades)
graph.add_node("behavior", llm_build_behavior_profile)
graph.add_node("decision", llm_strategy_decision)

graph.set_entry_point("intent")
graph.add_edge("intent", "emotion")
graph.add_edge("emotion", "similar")
graph.add_edge("similar", "behavior")
graph.add_edge("behavior", "decision")
graph.add_edge("decision", END)

app = graph.compile()

# -------------------------------
# 9️⃣ Test
# -------------------------------
if __name__ == "__main__":
    state = TradeState(input_text="Buy 200 shares of TSLA immediately, GTC")
    result = app.invoke(state)
    
    print("Intent:", result.intent)
    print("Emotion:", result.emotion)
    print("Similar trades:", result.similar_trades)
    print("Behavior Profile:", result.behavior_profile)
    print("Market Snapshot:", result.market_snapshot)
    print("Strategy Decision:", result.strategy)
