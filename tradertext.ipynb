class MockLLM:
    def invoke(self, prompt):
        if "emotion" in prompt.lower():
            return type('Response', (), {'content': '{"emotion": "URGENT"}'})
        elif "summarizing" in prompt.lower() or "behavior" in prompt.lower():
            return type('Response', (), {'content': '{"preferred_strategies": ["VWAP", "TWAP"], "avg_order_size": 300, "volatility_tolerance": "HIGH", "side_preference": "BUY", "time_sensitivity": "URGENT", "behavioral_notes": "Prefers aggressive strategies in volatile markets"}'})
        else:
            return type('Response', (), {'content': '{"strategy": "ICEBERG", "explanation": "Suitable for large urgent order in volatile market to minimize impact", "parameters": {"slice_size": 50, "min_qty": 10, "max_qty": 100, "randomize": true}}'})

class MockEmbeddings:
    def embed_documents(self, texts):
        dim = 1536
        return [[random.random() for _ in range(dim)] for _ in texts]
    
    def embed_query(self, text):
        dim = 1536
        return [random.random() for _ in range(dim)]

use_mock = "AZURE_OPENAI_API_KEY" not in os.environ

llm = AzureChatOpenAI(
    deployment=os.environ.get("AZURE_OPENAI_CHAT_DEPLOYMENT", "gpt-4o"),
    temperature=0,
    azure_api_key=os.environ.get("AZURE_OPENAI_API_KEY"),
    azure_endpoint=os.environ.get("AZURE_OPENAI_ENDPOINT"),
    azure_api_version=os.environ.get("AZURE_OPENAI_API_VERSION", "2024-02-15-preview")
) if not use_mock else MockLLM()

embeddings = AzureOpenAIEmbeddings(
    deployment=os.environ.get("AZURE_OPENAI_EMBED_DEPLOYMENT", "text-embedding-3-large"),
    azure_api_key=os.environ.get("AZURE_OPENAI_API_KEY"),
    azure_endpoint=os.environ.get("AZURE_OPENAI_ENDPOINT"),
    azure_api_version=os.environ.get("AZURE_OPENAI_API_VERSION", "2024-02-15-preview"),
    model="text-embedding-3-large"
) if not use_mock else MockEmbeddings()

