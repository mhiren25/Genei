# -------------------------------
# 2️⃣ Imports and Env Variables
# -------------------------------
import os
import json
import random
import numpy as np
import faiss
import re
from pydantic import BaseModel
from langgraph.graph import StateGraph, END
from langchain_openai import AzureChatOpenAI
from langchain.embeddings import AzureOpenAIEmbeddings

# -------------------------------
# 3️⃣ Synthetic 30-day Historical Market Data
# -------------------------------
def generate_synthetic_history(symbol, start_price, volatility=0.02, volume_min=1_000_000, volume_max=10_000_000, days=30):
    """
    Generate synthetic OHLCV history for testing
    """
    history = []
    price = start_price
    for i in range(days):
        change_pct = random.uniform(-volatility, volatility)
        close = round(price * (1 + change_pct),2)
        high = round(max(price, close) * (1 + random.uniform(0, volatility/2)),2)
        low = round(min(price, close) * (1 - random.uniform(0, volatility/2)),2)
        open_price = round(price,2)
        volume = random.randint(volume_min, volume_max)
        history.append({"date":f"Day-{days-i}","open":open_price,"high":high,"low":low,"close":close,"volume":volume})
        price = close
    return history

TSLA_HISTORY = generate_synthetic_history("TSLA", start_price=620, volatility=0.03)
AAPL_HISTORY = generate_synthetic_history("AAPL", start_price=275, volatility=0.015)
META_HISTORY = generate_synthetic_history("META", start_price=630, volatility=0.02)

MARKET_DATA = {"TSLA": TSLA_HISTORY, "AAPL": AAPL_HISTORY, "META": META_HISTORY}

# -------------------------------
# 4️⃣ Dynamic User Trade History (Synthetic)
# -------------------------------
def generate_user_history(symbols, num_trades_per_symbol=15):
    history = []
    for symbol, config in symbols.items():
        for _ in range(num_trades_per_symbol):
            trade = {
                "symbol": symbol,
                "strategy": random.choice(["VWAP","TWAP","MARKET","POC","ICEBERG"]),
                "quantity": random.randint(*config.get("quantity_range",(50,500))),
                "volatility": random.choice(config.get("volatility",["LOW","MEDIUM","HIGH"])),
                "days_ago": random.randint(1,30)  # match synthetic market days
            }
            history.append(trade)
    return history

SYMBOL_CONFIG = {
    "AAPL": {"volatility":["LOW","MEDIUM"], "quantity_range":(50,200)},
    "TSLA": {"volatility":["MEDIUM","HIGH"], "quantity_range":(100,500)},
    "META": {"volatility":["LOW","MEDIUM","HIGH"], "quantity_range":(50,300)}
}

USER_HISTORY = generate_user_history(SYMBOL_CONFIG, num_trades_per_symbol=15)

# -------------------------------
# 5️⃣ Azure LLM + Embeddings Initialization
# -------------------------------
llm = AzureChatOpenAI(
    deployment=os.environ["AZURE_OPENAI_DEPLOYMENT"],
    temperature=0,
    azure_api_key=os.environ["AZURE_OPENAI_API_KEY"],
    azure_endpoint=os.environ["AZURE_OPENAI_ENDPOINT"],
    azure_api_version=os.environ["AZURE_OPENAI_API_VERSION"]
)

embeddings = AzureOpenAIEmbeddings(
    deployment=os.environ["AZURE_OPENAI_DEPLOYMENT"],
    model="text-embedding-3-large",
    chunk_size=1,
    azure_api_key=os.environ["AZURE_OPENAI_API_KEY"],
    azure_endpoint=os.environ["AZURE_OPENAI_ENDPOINT"],
    azure_api_version=os.environ["AZURE_OPENAI_API_VERSION"]
)

# -------------------------------
# 6️⃣ TradeState Definition
# -------------------------------
class TradeState(BaseModel):
    input_text: str
    intent: dict = {}
    emotion: str = ""
    behavior_profile: dict = {}
    similar_trades: list = []
    strategy: dict = {}
    market_snapshot: dict = {}
    side: str = ""
    tif: str = ""

ALLOWED_STRATEGIES = ["MARKET","VWAP","TWAP","POC","ICEBERG"]

# -------------------------------
# 7️⃣ Parse User Intent
# -------------------------------
def parse_intent(state: TradeState):
    text = state.input_text.upper()
    side = "BUY" if "BUY" in text else "SELL" if "SELL" in text else "BUY"
    qty_match = re.search(r"(\d+)", text)
    quantity = int(qty_match.group(1)) if qty_match else 100
    symbol_match = re.search(r"(?:OF\s+)?([A-Z]+)", text)
    symbol = symbol_match.group(1) if symbol_match else "UNKNOWN"
    
    tif = "DAY"
    if "GTC" in text: tif="GTC"
    if "GTD" in text: tif="GTD"
    
    state.intent = {"symbol":symbol,"quantity":quantity,"side":side,"type":"MARKET","tif":tif}
    state.side = side
    state.tif = tif
    
    # Include synthetic market snapshot for the symbol
    if symbol in MARKET_DATA:
        snapshot = MARKET_DATA[symbol][-1]  # latest day
        state.market_snapshot = snapshot
    else:
        state.market_snapshot = {}
    
    return state

# -------------------------------
# 8️⃣ AI-Driven Emotion Detection
# -------------------------------
def llm_detect_emotion(state: TradeState):
    prompt = f"""
You are an AI that detects user emotion from trading input.
User Input: "{state.input_text}"
Return JSON only: {{ "emotion": "<CALM | PATIENT | URGENT | ANXIOUS>" }}
"""
    response = llm.invoke(prompt)
    try:
        state.emotion = json.loads(response.content).get("emotion","CALM")
    except:
        state.emotion="CALM"
    return state

# -------------------------------
# 9️⃣ Symbol-Specific Similar Trades
# -------------------------------
def trade_to_text(t):
    return f"{t['symbol']} {t['strategy']} qty {t['quantity']} vol {t['volatility']}"

def retrieve_similar_trades(intent, k=3):
    symbol_history = [h for h in USER_HISTORY if h["symbol"]==intent["symbol"]]
    if not symbol_history:
        return []
    texts = [trade_to_text(h) for h in symbol_history]
    vectors = embeddings.embed_documents(texts)
    vectors = np.array(vectors).astype("float32")
    index = faiss.IndexFlatL2(vectors.shape[1])
    index.add(vectors)
    query_text = f"{intent['symbol']} qty {intent['quantity']}"
    query_vec = np.array(embeddings.embed_query(query_text)).astype("float32").reshape(1,-1)
    _, idxs = index.search(query_vec, min(k,len(symbol_history)))
    return [symbol_history[i] for i in idxs[0]]

# -------------------------------
# 10️⃣ AI-Generated Behavior Profile
# -------------------------------
def llm_build_behavior_profile(state: TradeState):
    symbol_history = [h for h in USER_HISTORY if h["symbol"]==state.intent["symbol"]]
    trades_json = json.dumps(symbol_history) if symbol_history else json.dumps(USER_HISTORY)
    prompt = f"""
You are an AI summarizing user's trading behavior.
Input trades: {trades_json}
Return JSON only with:
- preferred_strategies: list
- avg_order_size: number
- volatility_tolerance: LOW/MEDIUM/HIGH
- side_preference: BUY/SELL/BALANCED
- time_sensitivity: PATIENT/URGENT/MIXED
- behavioral_notes: patterns
"""
    response = llm.invoke(prompt)
    try:
        state.behavior_profile = json.loads(response.content)
    except:
        state.behavior_profile = {}
    return state

# -------------------------------
# 11️⃣ AI Strategy Decision
# -------------------------------
def parse_json_from_llm(response_text):
    import re
    match = re.search(r"\{.*\}", response_text, re.DOTALL)
    if match:
        try: return json.loads(match.group())
        except: return {}
    return {}

def llm_strategy_decision(state: TradeState):
    prompt = f"""
You are a world-class financial trading strategist AI.
Recommend ONE execution strategy for this trade.

Order: {state.intent}
User Emotion: {state.emotion}
Behavior Profile: {state.behavior_profile}
Similar Trades: {retrieve_similar_trades(state.intent)}
Market Snapshot: {state.market_snapshot}

Respond in JSON only:
{{ "strategy": "<STRATEGY_NAME>", "explanation": "<WHY>" }}
"""
    response = llm.invoke(prompt)
    result = parse_json_from_llm(response.content)
    strategy = result.get("strategy","VWAP")
    explanation = result.get("explanation","Fallback strategy used")
    state.strategy = {"strategy": strategy, "explanation": explanation}
    return state

# -------------------------------
# 12️⃣ Build LangGraph Pipeline
# -------------------------------
graph = StateGraph(TradeState)
graph.add_node("intent", parse_intent)
graph.add_node("emotion", llm_detect_emotion)
graph.add_node("behavior", llm_build_behavior_profile)
graph.add_node("decision", llm_strategy_decision)
graph.set_entry_point("intent")
graph.add_edge("intent","emotion")
graph.add_edge("emotion","behavior")
graph.add_edge("behavior","decision")
graph.add_edge("decision",END)
app = graph.compile()

# -------------------------------
# 13️⃣ Test Run
# -------------------------------
state = TradeState(input_text="Buy 200 shares of TSLA immediately, GTC")
result = app.invoke(state)

print("Intent:", result.intent)
print("Emotion:", result.emotion)
print("Market Snapshot:", result.market_snapshot)
print("Behavior Profile:", result.behavior_profile)
print("Strategy Decision:", result.strategy)
