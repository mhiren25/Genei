class TradeState(BaseModel):
    input_text: str
    intent: dict = {}
    emotion: str = ""
    behavior_profile: dict = {}
    similar_trades: list = []
    strategy: dict = {}
    market_snapshot: dict = {}
    side: str = ""
    tif: str = ""
    user_requested_strategy: str = ""  # NEW: Track if user specified a strategy

ALLOWED_STRATEGIES = ["MOC", "VWAP", "TWAP", "POC"]

